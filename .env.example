# Private key for deploying contracts (without 0x prefix)
PRIVATE_KEY=

# Sepolia RPC URL (e.g., from Alchemy or Infura)
SEPOLIA_RPC_URL=

# Deployed contract addresses (fill these after deployment)
BAL_TOKEN_ADDRESS=
VOTING_ADDRESS=

# Optional: Election schedule (ISO 8601 format or Unix timestamp)
# ELECTION_START=2024-01-01T00:00:00Z
# ELECTION_END=2024-01-08T00:00:00Z

# Optional: Session ID for viewing results
# SESSION_ID=1
